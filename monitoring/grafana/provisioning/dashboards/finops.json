{
  "uid": "finops",
  "title": "FinOps cloud cost (sample data)",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Month forecast",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "finops_month_forecast_usd"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Monthly budget",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "finops_monthly_budget_usd"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Untagged spend",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "finops_untagged_share"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rightsizing saving / month",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "finops_potential_monthly_saving_usd"
        }
      ]
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Cost by service (60 days)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "finops_cost_usd_by_service",
          "legendFormat": "{{service}}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Cost by team",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "finops_cost_usd_by_team",
          "legendFormat": "{{team}}",
          "instant": true
        }
      ]
    }
  ]
}